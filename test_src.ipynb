using Test, DataFrames, HypothesisTests

# Supondo que df já está carregado como no src.ipynb

# Teste 1: Teste t para diferença de médias de temperatura entre 2013 e 2023
temps_2013 = df[df.ANO .== 2013, :TEMPERATURA_AR_BULBO_SECO]
temps_2023 = df[df.ANO .== 2023, :TEMPERATURA_AR_BULBO_SECO]
t_test_temp = UnequalVarianceTTest(temps_2013, temps_2023)

@test typeof(pvalue(t_test_temp)) == Float64
@test 0.0 <= pvalue(t_test_temp) <= 1.0

# Teste 2: Teste t para diferença de médias de precipitação entre março e setembro
precip_mar = df[df.MES .== 3, :PRECIP_mm]
precip_set = df[df.MES .== 9, :PRECIP_mm]
t_test_precip = UnequalVarianceTTest(precip_mar, precip_set)

@test typeof(pvalue(t_test_precip)) == Float64
@test 0.0 <= pvalue(t_test_precip) <= 1.0

# Teste 3: Teste qui-quadrado para uniformidade da direção do vento
using StatsBase
vento_setores = round.(df.VENTO_DIRECAO ./ 30) .* 30
contagem = countmap(vento_setores)
observed = collect(values(contagem))
expected = fill(mean(observed), length(observed))
chi_test = ChisqTest(observed, expected)

@test typeof(pvalue(chi_test)) == Float64
@test 0.0 <= pvalue(chi_test) <= 1.0

# Exibir resultados dos testes de hipótese
println("Teste t temperatura 2013 vs 2023: p-valor = ", pvalue(t_test_temp))
println("Teste t precipitação março vs setembro: p-valor = ", pvalue(t_test_precip))
println("Teste qui-quadrado vento: p-valor = ", pvalue(chi_test))